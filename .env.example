# Password for the local web app, not your Mercedes account password.
APP_PASSWORD=replace-with-a-long-local-app-password
# Default: reachable only on the Docker host. For LAN access, set BIND_ADDRESS=0.0.0.0
# and set PUBLIC_ORIGIN to the actual URL, e.g. http://192.168.1.20:8080.
BIND_ADDRESS=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Optional: pin a published commit tag or digest instead of latest.
MB_CONTROLLER_IMAGE=ghcr.io/davilag/mb-controller:latest
# Backend charge-schedule timezone; includes daylight-saving transitions.
TZ=Europe/London
